{
  "permissions": {
    "allow": [
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format:check)",
      "Bash(pnpm -C backend test)",
      "Bash(pnpm -C backend test:*)",
      "Bash(pnpm -C backend lint)",
      "Bash(pnpm -C backend typecheck)",
      "Bash(pnpm -C frontend test)",
      "Bash(pnpm -C frontend test:e2e)",
      "Bash(pnpm -C frontend lint)",
      "Bash(pnpm -C frontend typecheck)",
      "Bash(docker compose ps)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs)",
      "Bash(docker compose logs *)",
      "Bash(docker compose top)",
      "Bash(docker compose top *)",
      "mcp__Claude_in_Chrome__find",
      "mcp__Claude_in_Chrome__read_page",
      "mcp__Claude_in_Chrome__read_console_messages",
      "mcp__Claude_in_Chrome__tabs_context_mcp",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_console_logs",
      "mcp__Claude_Preview__preview_list",
      "mcp__computer-use__screenshot"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-fr-link.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-doc-write.sh"
          }
        ]
      }
    ]
  }
}
