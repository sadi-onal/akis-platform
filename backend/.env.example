# ============================================================
# AKIS Platform — Local Development Environment
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
# DEV_MODE=false
AKIS_PORT=3000
AKIS_HOST=0.0.0.0
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false

# Logging (set in shell, not here — see CLAUDE.md)
# LOG_LEVEL=info

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=akis_v2
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/akis_v2
DB_POOL_MAX=20

# --- Authentication & Session ---
AUTH_JWT_SECRET=<REQUIRED: openssl rand -hex 32>
AUTH_COOKIE_NAME=akis_sid
AUTH_COOKIE_MAXAGE=604800
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# --- GitHub (Pipeline — repo oluşturma, push, PR) ---
GITHUB_TOKEN=<REQUIRED: Fine-grained PAT — Contents + PRs + Metadata>
GITHUB_REPOSITORY=omeryasironal/akis-platform

# --- OAuth: GitHub (kullanıcı login + integration) ---
# OAuth App scopes: read:user user:email repo (last one needed for repo writes
# from the pipeline — bakkal flow: signup → "GitHub ile Bağla" → fikir → kod).
# DEV_MODE bypass: if DEV_MODE=true and these are unset/placeholder, the
# /api/integrations/github/oauth/start endpoint mocks the OAuth callback and
# uses GITHUB_TOKEN (above) as the per-user access token. See
# services/auth/githubOauthDevBypass.ts. Never active in production.
GITHUB_OAUTH_CLIENT_ID=<from GitHub Developer Settings → OAuth Apps>
GITHUB_OAUTH_CLIENT_SECRET=<from same>

# GitHub webhooks (optional — unsigned webhooks accepted without this)
# GITHUB_WEBHOOK_SECRET=

# --- OAuth: Google (kullanıcı login) ---
GOOGLE_OAUTH_CLIENT_ID=<from Google Cloud Console → Credentials>
GOOGLE_OAUTH_CLIENT_SECRET=<from same>
# NOT: Callback URL'ler .env'de tanımlanmaz.
# Kod FRONTEND_URL'den otomatik üretir: ${FRONTEND_URL}/auth/oauth/${provider}/callback

# --- Atlassian Remote MCP (Jira + Confluence) ---
# No env vars needed. AKIS uses the MCP SDK with Dynamic Client Registration
# against https://mcp.atlassian.com/v1/mcp/authv2 — the first OAuth attempt
# self-registers the AKIS instance. Per-user tokens land in oauth_accounts;
# the shared DCR client_id lands in mcp_oauth_clients.

# --- Email ---
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=resend için:
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=noreply@akisflow.com

# --- AI Service ---
AI_PROVIDER=mock
# AI_PROVIDER=anthropic için:
# ANTHROPIC_API_KEY=sk-ant-xxx
# AI_API_KEY=sk-ant-xxx
# AI_PROVIDER=google için (P1c — Gemini direct):
# GOOGLE_API_KEY=AIza...
# AI_MODEL=gemini-1.5-flash
AI_MODEL=claude-sonnet-4-6
AI_DETERMINISTIC_MODE=true

# AI retry configuration
AI_PLANNER_MAX_RETRIES=3
AI_RETRY_BASE_DELAY_MS=1000

# Anthropic caching
ANTHROPIC_PROMPT_CACHING=true
ANTHROPIC_CACHE_MIN_CHARS=1000

# --- AI Key Encryption ---
AI_KEY_ENCRYPTION_KEY=<REQUIRED: openssl rand -hex 32>
AI_KEY_ENCRYPTION_KEY_VERSION=v1

# --- Rate Limiting ---
# RATE_LIMIT_MAX and RATE_LIMIT_WINDOW are not parsed — values are hardcoded in server.ts.

# --- Feature Flags ---
FEATURE_FLAG_UNSTABLE_ROUTES=false
SCRIBE_DEV_GITHUB_BOOTSTRAP=false
SKIP_MCP_TESTS=true

# --- P8: Critic hard-block threshold (0-100, default 75) ---
# Minimum CriticAgent overallScore for code review to count as approved.
# Below this value the pipeline halts at `awaiting_critic_resolution` so
# the user can fix or override. Raise the bar to be stricter (e.g. 85)
# or lower it (e.g. 60) when iterating fast in dogfood mode.
CRITIC_APPROVAL_THRESHOLD=75
