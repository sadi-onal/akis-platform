# AKIS Platform - Edge Reverse Proxy Caddyfile
# Routes traffic based on hostname to appropriate backend/frontend
#
# Domains:
#   akisflow.com         -> Production
#   staging.akisflow.com -> Redirect to akisflow.com

{
    email {$ACME_EMAIL:admin@akisflow.com}
}

# ==============================================================================
# Production (akisflow.com)
# ==============================================================================
akisflow.com {
    encode gzip zstd

    # Security headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Waitlist redirect (edge-level for campaigns)
    @waitlist_redirect {
        path /waitlist
        query utm_source=*
    }
    handle @waitlist_redirect {
        redir {$WAITLIST_URL:https://forms.gle/3aVfEh1Q8929DSY2A}?{query} temporary
    }

    # Health check endpoint
    handle /health {
        reverse_proxy akis-prod-backend:3000
    }

    # Readiness check
    handle /ready {
        reverse_proxy akis-prod-backend:3000
    }

    # Version endpoint
    handle /version {
        reverse_proxy akis-prod-backend:3000
    }

    # API routes -> Backend
    handle /api/* {
        reverse_proxy akis-prod-backend:3000
    }

    # Auth routes — method-aware so SPA pages (GET /auth/login, /auth/signup,
    # /auth/privacy-consent, /auth/welcome-beta, /auth/forgot-password, etc.)
    # fall through to the static frontend handler. Only API mutations and the
    # GET-only API endpoints reach the backend.

    # OAuth callbacks always go to backend (all methods)
    handle /auth/oauth/* {
        reverse_proxy akis-prod-backend:3000
    }

    # POST/PUT/PATCH/DELETE /auth/* -> backend API
    @auth_mutation {
        method POST PUT PATCH DELETE
        path /auth/*
    }
    handle @auth_mutation {
        reverse_proxy akis-prod-backend:3000
    }

    # GET-only backend API endpoints under /auth/
    @auth_get_api path /auth/me /auth/health /auth/profile /auth/invite/*
    handle @auth_get_api {
        reverse_proxy akis-prod-backend:3000
    }

    # OpenAPI / Swagger
    handle /api/docs* {
        reverse_proxy akis-prod-backend:3000
    }

    handle /openapi.json {
        reverse_proxy akis-prod-backend:3000
    }

    # Metrics (internal)
    handle /metrics {
        reverse_proxy akis-prod-backend:3000
    }

    # Static frontend
    handle {
        root * /srv/prod-frontend
        try_files {path} /index.html
        file_server
    }

    log {
        output stdout
        format console
        level INFO
    }
}

# www redirect
www.akisflow.com {
    redir https://akisflow.com{uri} permanent
}

# HTTP -> HTTPS redirect
http://akisflow.com, http://www.akisflow.com {
    redir https://akisflow.com{uri} permanent
}

# ==============================================================================
# Staging redirect (staging.akisflow.com -> akisflow.com)
# ==============================================================================
staging.akisflow.com {
    redir https://akisflow.com{uri} permanent
}
